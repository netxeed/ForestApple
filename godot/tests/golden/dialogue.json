{
 "default_speed": 45,
 "dialogues": {
  "acto1_aida": {
   "lines": [
    {
     "pauses": [],
     "speaker": "Aida",
     "speed": 45.0,
     "text": "¿Alguna vez pensaste adónde vamos?"
    },
    {
     "pauses": [
      [
       30,
       0.5
      ]
     ],
     "speaker": "Aida",
     "speed": 45.0,
     "text": "No digo que Gala se equivoque. Solo que nadie volvió a contar."
    },
    {
     "pauses": [],
     "speaker": "Manzana",
     "speed": 45.0,
     "text": "Nunca lo pensé."
    },
    {
     "pauses": [],
     "speaker": "Aida",
     "speed": 45.0,
     "text": "Yo sí. Casi todas las noches."
    }
   ],
   "speaker": "Aida"
  },
  "acto1_gala": {
   "lines": [
    {
     "pauses": [],
     "speaker": "Gala",
     "speed": 45.0,
     "text": "¡Buen día! Mirá qué sol hay hoy."
    },
    {
     "pauses": [
      [
       22,
       0.4
      ]
     ],
     "speaker": "Gala",
     "speed": 45.0,
     "text": "Ojalá me coman pronto. Dicen que el cielo de las frutas es hermoso."
    },
    {
     "pauses": [],
     "speaker": "Manzana",
     "speed": 45.0,
     "text": "¿Quién lo vio?"
    },
    {
     "pauses": [
      [
       22,
       0.5
      ]
     ],
     "speaker": "Gala",
     "speed": 45.0,
     "text": "Nadie volvió a contar. Eso es porque están muy a gusto allá."
    }
   ],
   "speaker": "Gala"
  },
  "acto1_isolde": {
   "lines": [
    {
     "pauses": [],
     "speaker": "Isolde",
     "speed": 45.0,
     "text": "Buen día. Acomodé el estante para que no se caiga nada."
    },
    {
     "pauses": [
      [
       68,
       0.4
      ]
     ],
     "speaker": "Isolde",
     "speed": 45.0,
     "text": "Sobre lo que piensa Aida: yo creo que hay una explicación razonable. Nos eligen, nos comen. Es un ciclo."
    },
    {
     "pauses": [],
     "speaker": "Manzana",
     "speed": 45.0,
     "text": "¿Y si no es así?"
    },
    {
     "pauses": [
      [
       30,
       0.5
      ]
     ],
     "speaker": "Isolde",
     "speed": 45.0,
     "text": "En realidad, no tengo pruebas. Pero conozco cada rincón de este estante. Y a vos, a Gala, a Aida."
    },
    {
     "pauses": [],
     "speaker": "Isolde",
     "speed": 45.0,
     "text": "Es suficiente para mí."
    }
   ],
   "speaker": "Isolde"
  },
  "acto1_nino_llega": {
   "lines": [
    {
     "pauses": [],
     "speaker": "Manzana",
     "speed": 45.0,
     "text": "...¿Vos me escuchás?"
    },
    {
     "pauses": [],
     "speaker": "Niño",
     "speed": 45.0,
     "text": "Sí. Hablás bajito, pero te escucho."
    },
    {
     "pauses": [
      [
       21,
       0.4
      ]
     ],
     "speaker": "Manzana",
     "speed": 45.0,
     "text": "Pero soy una manzana. ¿No te asusta?"
    },
    {
     "pauses": [
      [
       23,
       0.5
      ]
     ],
     "speaker": "Niño",
     "speed": 45.0,
     "text": "Un poco raro, nada más. Con las cosas me pasa desde chico."
    },
    {
     "pauses": [],
     "speaker": "Niño",
     "speed": 45.0,
     "text": "Nadie me cree cuando lo cuento. Así que mejor quedémonos con el secreto."
    }
   ],
   "speaker": ""
  },
