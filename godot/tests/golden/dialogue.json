       0.5
      ]
     ],
     "speaker": "Sandía",
     "speed": 45.0,
     "text": "Mátame, manzana. Así se acaba esto."
    },
    {
     "pauses": [],
     "speaker": "Sandía",
     "speed": 45.0,
     "text": "INTÉNTALO."
    }
   ],
   "speaker": "Sandía"
