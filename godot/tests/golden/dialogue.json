  "sandia_intro": {
   "lines": [
    {
     "pauses": [],
     "speaker": "Sandía",
     "speed": 45.0,
     "text": "Así que vos sos la manzana negacionista."
    },
    {
     "pauses": [],
     "speaker": "Sandía",
     "speed": 45.0,
     "text": "Qué tontería. Todos vamos al cielo de las frutas."
    },
    {
     "pauses": [],
     "speaker": "Sandía",
     "speed": 45.0,
     "text": "Déjame mostrarte cómo se ve."
    }
   ],
   "speaker": "Sandía"
