  "sandia_fase2": {
   "lines": [
    {
     "pauses": [],
     "speaker": "Sandía",
     "speed": 45.0,
     "text": "¡Basta!"
    },
    {
     "pauses": [],
     "speaker": "Sandía",
     "speed": 45.0,
     "text": "El cielo de las frutas existe."
    },
    {
     "pauses": [],
