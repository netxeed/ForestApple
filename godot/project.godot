; Rebanada de prueba en Godot 4.x (no verificada: ver godot/README.md)
config_version=5

[application]

config/name="ForestApple"
run/main_scene="res://game.tscn"
config/icon="res://assets/icon.png"
config/features=PackedStringArray("4.3")

[display]

window/size/viewport_width=480
window/size/viewport_height=288
window/size/window_width_override=960
window/size/window_height_override=576
window/handheld/orientation=0
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[input_devices]

pointing/emulate_mouse_from_touch=false

[rendering]

textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.08, 0.1, 0.09, 1)
